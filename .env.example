# Server-side secrets for the Supabase Edge Functions.
#
# Do NOT create a real .env file in this repository, and never put these values in assets/js/config.js.
# Set them on your own computer with:
#     npx supabase secrets set NAME=value
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.

# Required. At least 32 random characters (openssl rand -hex 32). If you already set this for the
# earlier version, keep the same value: existing access codes depend on it.
CODE_PEPPER=

# Required. The website's origin, with no path and no trailing slash.
ALLOWED_ORIGIN=https://autttor.github.io

# Required for reviewer notifications. Comma-separated reviewer mailbox(es).
EMAIL_TO=

# Mail provider. "resend" sends real email and needs RESEND_API_KEY. "sandbox" sends nothing.
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Sender shown on notifications. Needs a domain verified in Resend. Leave empty to use Resend's
# test sender, which only delivers to the address the Resend account was created with.
EMAIL_FROM=

# Link placed in notification emails.
DASHBOARD_URL=https://autttor.github.io/unhtipline/admin/

# Required for the scheduled retry job. Another long random value (openssl rand -hex 32).
DISPATCH_SECRET=

# Leave this off. When "true", notification emails contain the student's full report, which then
# lives in ordinary mailboxes outside the dashboard's access controls and audit log.
EMAIL_INCLUDE_DETAILS=false
